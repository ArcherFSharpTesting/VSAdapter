<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FizzBuzz Convert Should.fs" />
    <Compile Include="Word Counter Should.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Archer.Core" Version="0.0.0.*" />
    <PackageReference Include="Archer.Validations" Version="0.0.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.3" />
    <PackageReference Update="FSharp.Core" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lib\Archer.VSAdapter.Lib.fsproj" />
  </ItemGroup>

</Project>
